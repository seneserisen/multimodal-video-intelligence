{
  "$defs": {
    "BoundingBox": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "maximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Width",
          "type": "number"
        },
        "height": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Height",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "BoundingBox",
      "type": "object"
    },
    "ErrorCode": {
      "enum": [
        "invalid_url",
        "unsupported_platform",
        "unavailable_media",
        "direct_provider_failure",
        "extractor_failure",
        "tab_capture_failure",
        "missing_audio",
        "missing_video",
        "silent_capture",
        "black_capture",
        "frozen_video",
        "incomplete_recording",
        "unsupported_codec",
        "ffmpeg_unavailable",
        "provider_unavailable",
        "missing_api_key",
        "provider_quota_or_rate_limit",
        "provider_timeout",
        "malformed_provider_output",
        "schema_validation_failure",
        "transcription_failure",
        "ocr_failure",
        "visual_analysis_failure",
        "cleanup_failure",
        "command_center_unavailable",
        "command_center_already_running",
        "update_unavailable",
        "dirty_worktree"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "EvidenceItem": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "modality": {
          "$ref": "#/$defs/Modality"
        },
        "evidence_type": {
          "title": "Evidence Type",
          "type": "string"
        },
        "start_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Ms"
        },
        "end_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Ms"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "source_reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Reference"
        },
        "frame_reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame Reference"
        },
        "bounding_box": {
          "anyOf": [
            {
              "$ref": "#/$defs/BoundingBox"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "entities": {
          "items": {
            "type": "string"
          },
          "title": "Entities",
          "type": "array"
        },
        "attributes": {
          "additionalProperties": true,
          "title": "Attributes",
          "type": "object"
        },
        "uncertainty": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uncertainty"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "processing_version": {
          "title": "Processing Version",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "modality",
        "evidence_type",
        "confidence",
        "provider",
        "processing_version"
      ],
      "title": "EvidenceItem",
      "type": "object"
    },
    "JobOperation": {
      "enum": [
        "validate",
        "transcribe"
      ],
      "title": "JobOperation",
      "type": "string"
    },
    "JobStage": {
      "enum": [
        "upload",
        "queue",
        "validation",
        "audio_extraction",
        "transcription",
        "complete"
      ],
      "title": "JobStage",
      "type": "string"
    },
    "JobStatus": {
      "enum": [
        "uploading",
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "JobStatus",
      "type": "string"
    },
    "MediaProbeResult": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "file_size_bytes": {
          "minimum": 0,
          "title": "File Size Bytes",
          "type": "integer"
        },
        "format_names": {
          "items": {
            "type": "string"
          },
          "title": "Format Names",
          "type": "array"
        },
        "duration_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "streams": {
          "items": {
            "$ref": "#/$defs/MediaStream"
          },
          "title": "Streams",
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/StructuredError"
          },
          "title": "Errors",
          "type": "array"
        },
        "has_video": {
          "readOnly": true,
          "title": "Has Video",
          "type": "boolean"
        },
        "has_audio": {
          "readOnly": true,
          "title": "Has Audio",
          "type": "boolean"
        },
        "valid": {
          "readOnly": true,
          "title": "Valid",
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "file_size_bytes",
        "format_names",
        "streams",
        "has_video",
        "has_audio",
        "valid"
      ],
      "title": "MediaProbeResult",
      "type": "object"
    },
    "MediaStream": {
      "additionalProperties": false,
      "properties": {
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "stream_type": {
          "enum": [
            "video",
            "audio",
            "subtitle",
            "data",
            "attachment",
            "unknown"
          ],
          "title": "Stream Type",
          "type": "string"
        },
        "codec_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Codec Name"
        },
        "duration_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        },
        "height": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "frame_rate": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame Rate"
        },
        "sample_rate_hz": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Rate Hz"
        },
        "channels": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Channels"
        }
      },
      "required": [
        "index",
        "stream_type"
      ],
      "title": "MediaStream",
      "type": "object"
    },
    "Modality": {
      "enum": [
        "speech",
        "screen_text",
        "visual_event",
        "audio_event",
        "metadata"
      ],
      "title": "Modality",
      "type": "string"
    },
    "StructuredError": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "safe_recovery_action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Safe Recovery Action"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "StructuredError",
      "type": "object"
    },
    "TranscriptionResult": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "processing_version": {
          "title": "Processing Version",
          "type": "string"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "language_confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language Confidence"
        },
        "evidence_items": {
          "items": {
            "$ref": "#/$defs/EvidenceItem"
          },
          "title": "Evidence Items",
          "type": "array"
        }
      },
      "required": [
        "provider",
        "processing_version",
        "evidence_items"
      ],
      "title": "TranscriptionResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[0-9a-f]{24}$",
      "title": "Job Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/JobStatus"
    },
    "stage": {
      "$ref": "#/$defs/JobStage",
      "default": "upload"
    },
    "operations": {
      "items": {
        "$ref": "#/$defs/JobOperation"
      },
      "title": "Operations",
      "type": "array"
    },
    "filename": {
      "title": "Filename",
      "type": "string"
    },
    "content_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content Sha256"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "progress": {
      "maximum": 1,
      "minimum": 0,
      "title": "Progress",
      "type": "number"
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "cancellation_requested": {
      "default": false,
      "title": "Cancellation Requested",
      "type": "boolean"
    },
    "recovered_after_restart": {
      "default": false,
      "title": "Recovered After Restart",
      "type": "boolean"
    },
    "media_retained": {
      "default": false,
      "title": "Media Retained",
      "type": "boolean"
    },
    "report": {
      "anyOf": [
        {
          "$ref": "#/$defs/MediaProbeResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "transcription": {
      "anyOf": [
        {
          "$ref": "#/$defs/TranscriptionResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/StructuredError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "job_id",
    "status",
    "filename",
    "created_at",
    "updated_at",
    "progress",
    "message"
  ],
  "title": "ProcessingJob",
  "type": "object"
}
