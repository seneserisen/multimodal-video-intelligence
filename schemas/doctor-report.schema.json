{
  "$defs": {
    "DoctorCheck": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "warning",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "recovery_action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recovery Action"
        }
      },
      "required": [
        "name",
        "status",
        "detail"
      ],
      "title": "DoctorCheck",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "ready": {
      "title": "Ready",
      "type": "boolean"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/DoctorCheck"
      },
      "title": "Checks",
      "type": "array"
    }
  },
  "required": [
    "ready",
    "checks"
  ],
  "title": "DoctorReport",
  "type": "object"
}
